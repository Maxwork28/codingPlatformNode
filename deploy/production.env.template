# =====================================================================================
# AlgoSutra API - production environment for AWS EC2
#
# On the server:   cp deploy/production.env.template .env   then fill every <...> value.
# .env is gitignored. Never commit real values. This template contains no secrets.
# =====================================================================================

# ---- Core (required) -----------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Use a database user with
# readWrite on this database only, and allow the EC2 Elastic IP in Atlas "Network Access".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/education_platform?retryWrites=true&w=majority
MONGO_POOL_SIZE=20

# Generate on the server:  openssl rand -base64 48     (must be at least 32 characters)
JWT_SECRET=<paste-output-of-openssl-rand-base64-48>
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- Public URLs (required) ----------------------------------------------------------
# Frontend origins allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=https://algosutra.co.in,https://www.algosutra.co.in
# React app URL: password-reset links and the Safe Exam Browser start page.
PUBLIC_APP_URL=https://algosutra.co.in
# This API exactly as browsers / Safe Exam Browser reach it: SEB launch links (sebs://...),
# SEB URL filter and Config Key checks.
API_PUBLIC_URL=https://api.algosutra.co.in
# nginx sits in front of the API: trust one proxy hop so rate limits see real client IPs.
TRUST_PROXY=1

# ---- Code judge ----------------------------------------------------------------------
# Containers running at once = vCPUs - 1  (c6i.xlarge / c7g.xlarge: 3, c6i.2xlarge: 7).
JUDGE_CONCURRENCY=3
# Runs allowed to wait for a free slot before students get "judge is busy, try again".
JUDGE_MAX_QUEUE=100
JUDGE_MAX_WAIT_MS=90000
# Judge work files in RAM (faster, nothing left on disk).
JUDGE_TEMP_DIR=/dev/shm/algosutra-judge
JUDGE_MODE=local

# ---- Email (needed for "Forgot password" and emailed login details) ---------------------
# Gmail: turn on 2-step verification, create an App Password and use it as SMTP_PASS.
# Other providers: set SMTP_SERVICE accordingly (nodemailer well-known service name).
SMTP_SERVICE=Gmail
SMTP_USER=<no-reply@yourdomain.com>
SMTP_PASS=<gmail-app-password>
SMTP_FROM="AlgoSutra <no-reply@yourdomain.com>"

# ---- File uploads (question images, avatars) -> S3 --------------------------------------
# Recommended: attach an IAM ROLE to the EC2 instance with s3:PutObject on this bucket and
# leave the two key variables EMPTY - the AWS SDK then uses the instance role automatically.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<your-bucket-name>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CloudFront (or custom domain) in front of the bucket, no trailing slash:
# AWS_S3_PUBLIC_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
AWS_S3_KEY_PREFIX=questions
# Only if the bucket uses ACLs instead of a bucket policy:
# AWS_S3_OBJECT_ACL=public-read

# ---- AI-generated-code detection (optional) -------------------------------------------
# Without any key teachers paste AI reference solutions themselves ("AI references" on the
# exam report). With a key, references are generated automatically from the question text.
# Student code is never sent to these providers.
# OPENAI_API_KEY=<sk-...>
# OPENAI_MODEL=gpt-6.1-sol
# GEMINI_API_KEY=<...>
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=<...>
# ANTHROPIC_MODEL=claude-sonnet-5-5
AI_AUTO_GENERATE=1
AI_REF_VARIANTS=3

# ---- Rate limits (defaults shown; per user / per IP) ------------------------------------
RATE_AUTH_MAX=20
RATE_JUDGE_MAX=30
RATE_API_MAX=600

# ---- Logging -------------------------------------------------------------------------
LOG_LEVEL=info

# ---- First boot only -------------------------------------------------------------------
# Creates the database indexes. Set to 1 for the FIRST start, then remove it (or set 0).
SYNC_INDEXES=1

# ---- Scaling (leave commented until you need it; see DEPLOY.md section 7) --------------
# REDIS_URL=redis://<elasticache-endpoint>:6379
# JUDGE_MODE=queue
