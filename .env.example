# Mongo
MONGO_URI=mongodb://localhost:27017/education_platform
JWT_SECRET=
PORT=5000

# Question images: set AWS_S3_BUCKET or AWS_S3_BUCKET_NAME. Without it, files stay in /uploads/questions.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=
# CloudFront or custom domain (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://dxxxxx.cloudfront.net
# AWS_S3_KEY_PREFIX=questions
