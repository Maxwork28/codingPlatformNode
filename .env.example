# Required
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://localhost:27017/education_platform
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Frontend origin(s), comma separated. Required in production.
CORS_ORIGINS=https://algosutra.co.in,https://www.algosutra.co.in
# Used to build password-reset links in emails
PUBLIC_APP_URL=https://algosutra.co.in
# Set to 1 behind nginx / ALB so rate limits see the real client IP
TRUST_PROXY=1
# Public URL of this API exactly as browsers reach it (scheme + host [+ path prefix], no trailing slash).
# Used by Safe Exam Browser support: launch links (sebs://<host>/exams/...), the SEB URL filter and the
# Config Key check. https -> sebs:// links, http -> seb:// links. If unset, production derives it from
# the request's Host / X-Forwarded-Host; development uses http://localhost:$PORT.
API_PUBLIC_URL=https://api.algosutra.co.in

# Judge
# Containers run in parallel per process (local mode) or per worker host (queue mode). Default vCPUs-1.
JUDGE_CONCURRENCY=3
# Runs allowed to wait for a slot before new ones get HTTP 429 (per process / per queue).
JUDGE_MAX_QUEUE=100
# How long a run may wait for a slot before 429 "overloaded" (ms).
# JUDGE_MAX_WAIT_MS=90000
# JUDGE_TEMP_DIR=/dev/shm/algosutra-judge

# Optional: Redis (ElastiCache / self-hosted). Unset = single-process behaviour, nothing else changes.
# When set: Socket.IO rooms span processes, rate limits are shared across processes, and
# JUDGE_MODE=queue becomes available. rediss:// for TLS.
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REDIS_PREFIX=algosutra:rl

# local (default): this API process runs judge containers itself.
# queue: the API enqueues runs (BullMQ) and `node workers/judgeWorker.js` processes on judge hosts
#        execute them; the API host then needs no Docker. Requires REDIS_URL (else falls back to local).
# JUDGE_MODE=local
# JUDGE_QUEUE_PREFIX=algosutra

# Judge worker host only (workers/judgeWorker.js): needs REDIS_URL + JUDGE_* (+ Docker and the
# judge images); MONGO_URI / JWT_SECRET / CORS are not needed. PM2 sets CONFIG_ROLE=worker for it.
# CONFIG_ROLE=worker
# JUDGE_WORKER_SHUTDOWN_MS=200000

# Optional: email (password reset, credential emails)
# SMTP_SERVICE=Gmail
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AlgoSutra <no-reply@algosutra.co.in>"

# Question images and avatars go to S3 when a bucket is set; otherwise /uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BASE_URL=https://dxxxxx.cloudfront.net
# AWS_S3_KEY_PREFIX=questions

LOG_LEVEL=info

# Optional: AI-generated-code detection for exam coding answers.
# Student answers are compared ON THIS SERVER with AI reference solutions; student code is never sent
# to a provider. Without any key teachers paste references manually ("AI references" on the exam report).
# With keys, references are generated from the question text (title, statement, formats, samples, stub).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=low
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Base URL overrides (proxies / tests): OPENAI_BASE_URL, GEMINI_BASE_URL, ANTHROPIC_BASE_URL
# Prompt variants per provider per language (1-6); auto-generate on the first answer with no references.
# AI_REF_VARIANTS=3
# AI_AUTO_GENERATE=1
# AI_CHECK_CONCURRENCY=2
# AI_PROVIDER_CONCURRENCY=3
# AI_REQUEST_TIMEOUT_MS=90000
# AI_MAX_RETRIES=3
# AI_MAX_CALLS_PER_JOB=150
# Answers with fewer tokens than this (after removing starter code / common I/O) report "too short".
# AI_MIN_TOKENS=25
