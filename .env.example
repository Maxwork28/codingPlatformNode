# Mongo
MONGO_URI=mongodb://localhost:27017/education_platform
JWT_SECRET=
PORT=5000

# Question images: set AWS_S3_BUCKET to store on S3. Without it, files stay in /uploads/questions.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional public/CDN base (no trailing slash). Defaults to https://{bucket}.s3.{region}.amazonaws.com
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
# AWS_S3_KEY_PREFIX=questions
# Needed on buckets that still allow ACLs:
# AWS_S3_OBJECT_ACL=public-read
